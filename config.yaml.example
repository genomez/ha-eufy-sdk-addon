# Local candidate, built by Supervisor from the accompanying source context.
name: S1 source preview (not an installable release)
version: "0.4.0-s1.1"
slug: eufy_sdk_t9000_pilot
stage: experimental
description: Reference configuration for experimental S1 source; public installation is not qualified.
url: https://github.com/genomez/ha-eufy-sdk-addon/tree/s1-experimental
arch:
  - amd64
init: false
startup: application
boot: manual
# Leave room for the runtime's 45-second bounded shutdown before Supervisor force-stops it.
timeout: 60
hassio_api: true
discovery:
  - eufy_sdk
ingress: true
ingress_port: 3000
panel_icon: mdi:cctv
# Core uses the add-on's internal DNS name. Raw APIs are not published on the host.
ports:
  3000/tcp: null
  8554/tcp: null
ports_description:
  3000/tcp: Optional host publication of bridge control; internal Core access is available without it.
  8554/tcp: Optional host publication of RTSP; internal Core access is available without it.
options:
  email: ""
  password: ""
  country: GB
  # Optional tuning â€” these mirror the bridge's own defaults, so leaving them is a no-op.
  poll_ms: 600000
  rtc_state_refresh_ms: 0
  # Optional S1 storage: hourly admission on an existing idle session, no retries.
  s1_storage_telemetry: false
  stream_idle_ms: 300000
  # Disable unsolicited native RTSP setting writes initially; deliberate controls remain available.
  rtsp_idle_off_ms: 0
  prewarm: false
  event_log: false
  debug: false
  debug_p2p: false
  go2rtc_enable: true
  # â”€â”€ Anker Solix (optional; a SEPARATE Anker account from eufy) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  # Leave email + password empty to keep Solix OFF. Fill BOTH to add the Solarbank / smart-meter
  # entities. The rest mirror the bridge defaults, so leaving them is a no-op.
  solix_email: ""
  solix_password: ""
  solix_country: ""
  solix_scene_poll_ms: 90000
  solix_retry_base_ms: 900000
  solix_retry_max_ms: 3600000
schema:
  email: str
  password: password
  country: str
  # How often the bridge re-reads device state from the cloud (ms); 0 disables polling.
  poll_ms: int(0,)
  # Optional shared RTC state reads: 0 disables; otherwise 30000..600000 ms.
  rtc_state_refresh_ms: int(0,600000)
  s1_storage_telemetry: bool
  # Auto-off a camera's live P2P feed after this long with no detection (ms); 0 disables. Saves battery.
  stream_idle_ms: int(0,)
  # Turn a BATTERY camera's native rtspStream OFF after this long idle (ms); 0 disables. Wired untouched.
  rtsp_idle_off_ms: int(0,)
  # How long a BATTERY camera may stream continuously (ms). Empty keeps the SDK default (45s + 10s grace),
  # so a watched battery stream drops every ~55s and the reconnect wakes the camera again. Raise it
  # (e.g. 180000) to keep a watched stream up. Mains cameras ignore it.
  stream_battery_budget_ms: "int(1,)?"
  # Speculatively open a camera's P2P on a high-intent event (doorbell/person/pet/package) so live
  # view starts instantly. Off by default â€” it holds a battery camera's radio ~28s per event.
  prewarm: bool
  # Log one line per push/semantic event (what it is, clients reached, image fetches). On by default.
  event_log: bool
  # Verbose bridge logging (WS commands, control timing, P2P connect/close). Off by default.
  debug: bool
  # Additionally route the raw per-frame P2P transport logs (very noisy). Off by default.
  debug_p2p: bool
  # Run the bundled go2rtc process. Turn OFF if you run go2rtc as a separate container/service
  # on the same host (ports 8554/1984), so the bundled one does not clash with it.
  go2rtc_enable: bool
  # Anker Solix account (separate from eufy). Fill BOTH email + password to enable Solix; empty = off.
  solix_email: "str?"
  solix_password: "password?"
  # Two-letter Solix account country (e.g. GB, DE); empty falls back to the eufy country above.
  solix_country: "str?"
  # Scene backstop poll cadence (ms) â€” the slow authed read filling battery temp + a SOC cross-check.
  solix_scene_poll_ms: "int(5000,)?"
  # Login self-heal backoff: base delay then cap (ms). Anker throttles frequent logins â€” keep generous.
  solix_retry_base_ms: "int(10000,)?"
  solix_retry_max_ms: "int(10000,)?"
